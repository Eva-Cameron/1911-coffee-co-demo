---
/** The end credits: the wordmark, the cast, the set and the essential details, then a closing line. */
import Wordmark from "./Wordmark.astro";
import Seal from "./Seal.astro";
import site from "../content/site.json";
import { chapters } from "../content/chapters";
const credits = [
  { role: "Starring", names: ["Coffee", "Breakfast", "Lunch", "Cake", "You"] },
  { role: "Filmed on location at", names: [`${site.street}, ${site.town}`] },
  { role: "Photography", names: ["1911 Coffee Co."] },
  { role: "Website", names: ["Eva Cameron"] },
];
---
<footer class="credits field-burgundy">
  <div class="wrap--narrow inner">
    <div class="seal-wrap" aria-hidden="true"><Seal size={84} /></div>
    <Wordmark size="lg" tone="cream" />
    <dl class="roles">
      {credits.map((c) => (
        <div><dt class="label">{c.role}</dt><dd>{c.names.join(" · ")}</dd></div>
      ))}
    </dl>
    <div class="essentials">
      <p class="mono">{site.street} · {site.town} · {site.postcode}</p>
      <p class="mono"><a href={`tel:${site.phoneHref}`}>{site.phone}</a> · <a href={site.directions} rel="noopener">Directions</a> · <a href={`#${chapters.menu.id}`}>Menu</a></p>
      <ul class="socials">
        {site.socials.map((s) => <li><a class="link" href={s.href} rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
    <p class="the-end"><span class="display">The End.</span> <em>(Of the website. The coffee continues.)</em></p>
    <p class="mono small">© {new Date().getFullYear()} 1911 Coffee Co.</p>
  </div>
</footer>
<style>
  .credits { padding: var(--space-8) 0 var(--space-6); text-align: center; }
  .inner { display: grid; justify-items: center; gap: var(--space-6); }
  .seal-wrap { color: var(--custard); }
  :global(.motion) .seal-wrap :global(svg) { animation: turn 60s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }
  .roles { display: grid; gap: var(--space-4); margin: 0; }
  .roles dt { color: var(--custard); margin-bottom: 4px; }
  .roles dd { margin: 0; font: italic 400 22px/1.3 var(--font-serif); }
  .essentials { display: grid; gap: 10px; padding-top: var(--space-5); border-top: 1px solid rgb(248 240 223 / .3); width: 100%; }
  .socials { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 24px; }
  .socials .link { color: var(--cream); }
  .the-end { font-family: var(--font-serif); font-size: 20px; }
  .the-end .display { font-size: 28px; color: var(--custard); }
  .small { opacity: .8; }
</style>
