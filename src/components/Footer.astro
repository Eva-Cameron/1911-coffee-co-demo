---
import site from "../content/site.json";
---
<footer class="footer">
  <div class="wrap">
    <p class="name" aria-hidden="true">{site.name}</p>
    <div class="cols">
      <p>{site.street}<br />{site.town} {site.postcode}</p>
      <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      <ul>
        {site.socials.map((s) => <li><a href={s.href} rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
    <div class="base">
      <p>© {new Date().getFullYear()} 1911 Coffee Co Ltd</p>
      <p>Website by Eva Cameron</p>
    </div>
  </div>
</footer>
<style>
  .footer { background: var(--deep); color: var(--on-deep); padding: 96px 0 32px; }
  .name {
    font-size: clamp(30px, 8.4vw, 132px); font-weight: 700; line-height: 1; letter-spacing: -.04em;
    color: var(--orange); white-space: nowrap; margin: 0 0 64px -.05em;
  }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; font-size: 17px; line-height: 1.5; }
  .cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .footer a { color: var(--on-deep); text-decoration-color: var(--orange); text-decoration-thickness: 2px; }
  .footer a:hover { color: var(--orange); }
  .base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 72px; font-size: 14px; color: rgb(246 240 230 / .8); }
  .footer :global(:focus-visible) { outline-color: var(--orange); }
  @media (max-width: 767px) {
    .footer { padding-top: 64px; }
    .name { margin-bottom: 40px; }
    .cols { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
