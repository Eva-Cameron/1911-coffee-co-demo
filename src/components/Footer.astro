---
import Roundel from "./Roundel.astro";
import site from "../content/site.json";
const icons: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>',
  Facebook: '<path d="M14 21v-8h3l.5-3.5H14V7.5c0-1 .3-1.7 1.8-1.7H18V2.6A24 24 0 0 0 15.2 2.5C12.6 2.5 11 4 11 6.9v2.6H8V13h3v8"/>',
  Tripadvisor: '<circle cx="7" cy="13" r="4"/><circle cx="17" cy="13" r="4"/><circle cx="7" cy="13" r="1" fill="currentColor"/><circle cx="17" cy="13" r="1" fill="currentColor"/><path d="M3 9.5C5.5 7 8.6 6 12 6s6.5 1 9 3.5M12 6l-1.8 3M12 6l1.8 3"/>',
};
---
<footer class="footer">
  <div class="wrap inner">
    <Roundel size={88} tone="cream" title="1911 Coffee Co." />
    <p class="type line">{site.street} · {site.town} {site.postcode} · <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
    <ul class="socials">
      {site.socials.map((s) => (
        <li><a href={s.href} aria-label={s.name} rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.name]} />
        </a></li>
      ))}
    </ul>
    <p class="small">© {new Date().getFullYear()} 1911 Coffee Co Ltd · Website by Eva Cameron</p>
  </div>
</footer>
<style>
  .footer { background: var(--charcoal); color: var(--cream); padding: var(--space-6) 0 var(--space-5); }
  .inner { display: grid; justify-items: center; gap: var(--space-4); text-align: center; }
  .footer a { color: var(--cream); }
  .line { font-size: 15px; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-2); }
  .socials a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(246 239 228 / .35); transition: background .3s; }
  .socials a:hover { background: rgb(246 239 228 / .1); }
  .small { font-size: 14px; opacity: .8; }
  .footer :global(:focus-visible) { outline-color: var(--orange); }
</style>
