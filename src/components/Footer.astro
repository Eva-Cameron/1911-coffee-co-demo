---
import Roundel from "./Roundel.astro";
import Icon from "./Icon.astro";
import site from "../content/site.json";
const icons: Record<string, string> = { Instagram: "instagram-logo", Facebook: "facebook-logo", Tripadvisor: "star" };
---
<footer class="footer">
  <div class="wrap inner">
    <div class="brand">
      <Roundel size={64} tone="cream" title="1911 Coffee Co." />
      <p>{site.street}<br />{site.town} {site.postcode}</p>
    </div>
    <ul class="socials">
      {site.socials.map((s) => (
        <li><a class="social" href={s.href} rel="noopener"><Icon name={icons[s.name]} size={18} />{s.name}</a></li>
      ))}
      <li><a class="social call" href={`tel:${site.phoneHref}`}><Icon name="phone" size={18} />{site.phone}</a></li>
    </ul>
  </div>
  <div class="wrap base">
    <p>© {new Date().getFullYear()} 1911 Coffee Co Ltd</p>
    <p>Website by Eva Cameron</p>
  </div>
</footer>
<style>
  .footer { background: var(--charcoal); color: var(--ink); padding: var(--space-6) 0 var(--space-4); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-5); padding-bottom: var(--space-5); border-bottom: 1px solid rgb(255 243 228 / .14); }
  .brand { display: flex; align-items: center; gap: var(--space-4); font-size: 15px; line-height: 1.45; }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .social {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border-radius: var(--radius-control); background: rgb(255 243 228 / .1); color: var(--ink);
    text-decoration: none; font-weight: 600; font-size: 14.5px; transition: background .15s;
  }
  .social:hover { background: rgb(255 243 228 / .2); color: var(--ink); }
  .social:active { background: rgb(255 243 228 / .26); }
  .call { background: var(--orange); color: var(--on-fill); }
  .call:hover { background: var(--orange-hover); color: var(--on-fill); }
  .base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); padding-top: var(--space-4); font-size: 13.5px; color: rgb(255 243 228 / .75); }
  .footer :global(:focus-visible) { outline-color: var(--orange); }
</style>
