---
import Roundel from "./Roundel.astro";
import site from "../content/site.json";
---
<footer class="footer">
  <div class="wrap inner">
    <Roundel size={72} tone="cream" title="1911 Coffee Co." />
    <p class="name" aria-hidden="true">{site.name}</p>
    <p class="addr">{site.street} · {site.town} · {site.postcode} · <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
    <ul class="links">
      {site.socials.map((s) => <li><a href={s.href} rel="noopener">{s.name}</a></li>)}
    </ul>
    <div class="base">
      <p>© {new Date().getFullYear()} 1911 Coffee Co Ltd</p>
      <p>Website by Eva Cameron</p>
    </div>
  </div>
</footer>
<style>
  .footer { background: var(--maroon); color: var(--paper); padding: 104px 0 36px; }
  .inner { display: grid; justify-items: center; gap: 28px; text-align: center; }
  .name { font-family: var(--font-title); font-size: clamp(26px, 4.4vw, 60px); font-weight: 600; letter-spacing: .06em; line-height: 1; color: var(--orange); white-space: nowrap; }
  .addr { font-size: 17px; letter-spacing: .04em; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; gap: 32px; flex-wrap: wrap; justify-content: center; }
  .links a { font-size: 14px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  .footer a { color: var(--paper); text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: .4em; }
  .footer a:hover { color: var(--orange); }
  .base { display: flex; gap: 32px; flex-wrap: wrap; justify-content: center; margin-top: 56px; font-size: 14px; color: rgb(251 243 234 / .8); }
  .footer :global(:focus-visible) { outline-color: var(--orange); }
  @media (max-width: 767px) { .footer { padding-top: 72px; } .addr { font-size: 15px; } }
</style>
