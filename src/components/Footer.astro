---
/* The footer in the shop's own colours: orange ground, espresso type, the wordmark and the essentials. */
import Wordmark from "./Wordmark.astro";
import site from "../content/site.json";
---
<footer class="footer" style="--wm-ground: var(--orange)">
  <div class="wrap inner">
    <Wordmark size="lg" />
    <p class="addr">{site.street}, {site.town}, {site.postcode}<br /><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
    <p class="hours">Monday to Saturday, 8am to 3pm · Closed Sunday</p>
    <ul class="links">
      {site.socials.map((s) => <li><a href={s.href} rel="noopener">{s.name}</a></li>)}
    </ul>
    <div class="base">
      <p>© {new Date().getFullYear()} 1911 Coffee Co Ltd</p>
      <p>Website by Eva Cameron</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--orange); color: var(--espresso); padding: clamp(72px, 9vw, 112px) 0 36px; }
  .inner { display: grid; justify-items: center; gap: 26px; text-align: center; }
  .addr { font: 400 var(--step-lead)/1.5 var(--font-head); font-variation-settings: "SOFT" 100; }
  .hours { font: 500 14px/1.4 var(--font-mono); letter-spacing: .06em; }
  .links { display: flex; gap: 32px; flex-wrap: wrap; justify-content: center; }
  .links a { font: 600 14px/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; }
  .footer a { color: var(--espresso); text-decoration-color: var(--espresso); text-decoration-thickness: 2px; text-underline-offset: .35em; }
  .footer a:hover { color: var(--espresso); text-decoration-thickness: 3px; }
  .footer :global(:focus-visible) { outline-color: var(--espresso); }
  .base { display: flex; gap: 28px; flex-wrap: wrap; justify-content: center; margin-top: 24px; padding-top: 22px; border-top: 1px solid rgb(51 38 34 / .35); width: min(100%, 640px); font-size: 14px; }
</style>
