---
import ChapterHead from "./ChapterHead.astro";
import Plate from "./Plate.astro";
import window from "../assets/photos/story.jpg";
---
<section id="welcome" class="chapter field-cream" aria-labelledby="welcome-title">
  <div class="wrap split">
    <Plate src={window} ratio="4 / 5"
      alt="The 1911 Coffee Co. window logo seen at dusk, under the café's hanging lights" />
    <div class="copy">
      <ChapterHead label="About us" id="welcome-title" align="start"
        title="Some places are worth <em>slowing down</em> for." />
      <div class="prose">
        <p data-reveal>1911 Coffee Co. opened behind the orange front at 28–30 Queen Street in October 2019.</p>
        <p data-reveal style="--i:1">It is a small place with a simple idea: a good cup of coffee, a proper bite to eat, and the uncomplicated pleasure of being made welcome.</p>
        <p class="aside" data-reveal style="--i:2">The 1911 is in the name, not the history books.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(40px, 7vw, 96px); align-items: center; }
  .copy :global(.head) { margin-bottom: 28px; }
  .prose { display: grid; gap: 18px; max-width: 46ch; }
  .aside { font-family: var(--font-head); font-size: var(--step-lead); }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .copy { order: -1; }
  }
</style>
