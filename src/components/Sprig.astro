---
/** A coffee branch in a single hairline stroke: a stem, paired leaves, and three cherries. Decorative. */
interface Props { class?: string; flip?: boolean; }
const { class: cls, flip = false } = Astro.props;
---
<svg class:list={["sprig", cls]} viewBox="0 0 140 140" width="140" height="140" aria-hidden="true"
  style={flip ? "transform:scale(-1,-1)" : undefined}>
  <g fill="none" stroke="var(--charcoal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 132 C 40 104, 70 70, 128 12" />
    <path d="M34 108 C 22 92, 24 76, 36 66 C 44 82, 44 96, 34 108 Z M34 108 L 36 70" />
    <path d="M40 102 C 58 104, 70 96, 74 84 C 58 82, 46 88, 40 102 Z M40 102 L 70 86" />
    <path d="M66 74 C 56 58, 60 42, 74 34 C 80 50, 78 64, 66 74 Z M66 74 L 73 38" />
    <path d="M72 68 C 90 70, 102 60, 104 48 C 88 46, 76 54, 72 68 Z M72 68 L 100 50" />
    <path d="M100 40 C 96 28, 102 18, 112 14 C 114 26, 110 36, 100 40 Z" />
    <circle cx="52" cy="90" r="4.2" /><circle cx="58" cy="96" r="3.8" /><circle cx="49" cy="98" r="3.4" />
    <circle cx="88" cy="56" r="3.6" /><circle cx="92" cy="63" r="3.2" />
  </g>
</svg>
