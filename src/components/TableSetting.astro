---
/**
 * An original line illustration: a table for two, set symmetrically. Checked cloth, two cups on
 * saucers, a sugar bowl and a small vase with a sprig at the centre. Decorative.
 */
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<svg class:list={["table-setting", cls]} viewBox="0 0 560 300" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ts-check" width="20" height="20" patternUnits="userSpaceOnUse">
      <rect width="20" height="20" fill="var(--paper)" />
      <rect width="10" height="10" fill="var(--cherry)" opacity=".85" /><rect x="10" y="10" width="10" height="10" fill="var(--cherry)" opacity=".85" />
    </pattern>
  </defs>
  <g fill="none" stroke="var(--espresso)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <!-- the table and its cloth -->
    <path d="M40 196h480" />
    <path d="M70 196v96M490 196v96" />
    <path d="M60 196l20 52h400l20-52z" fill="url(#ts-check)" />
    <!-- left cup -->
    <ellipse cx="150" cy="192" rx="46" ry="7" fill="var(--paper)" />
    <path d="M118 150h64v12a32 32 0 0 1-64 0z" fill="var(--paper)" />
    <path d="M182 156h8a10 10 0 0 1 0 20h-10" />
    <path d="M136 138c-5-7 5-10 0-18M150 138c-5-7 5-10 0-18M164 138c-5-7 5-10 0-18" stroke-width="1.6" opacity=".7" />
    <!-- right cup, mirrored -->
    <ellipse cx="410" cy="192" rx="46" ry="7" fill="var(--paper)" />
    <path d="M378 150h64v12a32 32 0 0 1-64 0z" fill="var(--paper)" />
    <path d="M378 156h-8a10 10 0 0 0 0 20h10" />
    <path d="M396 138c-5-7 5-10 0-18M410 138c-5-7 5-10 0-18M424 138c-5-7 5-10 0-18" stroke-width="1.6" opacity=".7" />
    <!-- sugar bowl -->
    <path d="M250 170h60v6a30 22 0 0 1-60 0z" fill="var(--custard)" />
    <path d="M262 170c2-10 34-10 36 0" />
    <circle cx="280" cy="160" r="3.5" fill="var(--espresso)" />
    <!-- vase and sprig -->
    <path d="M272 126c-6-14 22-14 16 0l-2 6h-12z" fill="var(--sky)" />
    <path d="M280 120C280 96 270 78 262 64M280 112c4-18 14-30 24-38" />
    <path d="M262 64c-10-4-14-14-10-20 8 2 12 10 10 20zM304 74c4-10 14-12 20-8-4 8-12 10-20 8zM271 86c-10 0-16-6-16-12 8-1 14 4 16 12z" fill="var(--mint)" />
  </g>
</svg>
<style>
  .table-setting { width: 100%; max-width: 560px; margin-inline: auto; overflow: visible; }
  .table-setting :global(path), .table-setting :global(ellipse) { vector-effect: non-scaling-stroke; }
</style>
