---
import { Picture } from "astro:assets";
import breakfast from "../assets/photos/breakfast.jpg";
import lunch from "../assets/photos/menu.jpg";
const plates = [
  { src: breakfast, alt: "A bacon and hash brown bun on a dark plate", caption: "Bacon and hash brown bun" },
  { src: lunch, alt: "A sandwich with coleslaw and salad on a black slate", caption: "Sandwich, slaw and salad" },
];
---
<section id="kitchen" class="kitchen section field-stone" aria-labelledby="kitchen-title">
  <div class="wrap">
    <div class="chapter">
      <p class="part">Chapter three</p>
      <h2 id="kitchen-title" data-type data-type-speed="55">From the kitchen</h2>
      <p>Cooked to order and on the table a few minutes later.</p>
    </div>
    <div class="pair">
      {plates.map((p, i) => (
        <figure data-reveal style={`--i:${i + 1}`}>
          <div class="mat"><Picture src={p.src} alt={p.alt} widths={[600, 960]} sizes="(max-width: 767px) 100vw, 460px" formats={["avif", "webp"]} loading="lazy" /></div>
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 460px)); justify-content: center; gap: 56px; }
  figure { margin: 0; display: grid; gap: 20px; }
  .mat { aspect-ratio: 1; overflow: hidden; }
  .mat :global(picture) { display: block; height: 100%; }
  figcaption { text-align: center; font-size: 14px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  figure:hover .mat :global(img) { transform: scale(1.03); }
  .mat :global(img) { transition: transform .6s var(--ease-out); }
  @media (max-width: 767px) {
    .pair { grid-template-columns: 1fr; gap: 40px; }
    .mat { padding: 8px; }
  }
</style>
