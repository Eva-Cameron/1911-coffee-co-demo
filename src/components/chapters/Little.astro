---
/**
 * Chapter V — the little things. Paper field: a curated sequence of three photographs, set at
 * different heights like prints laid on a table, then two small exhibits you can play with.
 */
import Intertitle from "../Intertitle.astro";
import Plate from "../Plate.astro";
import latte from "../../assets/photos/latte.jpg";
import cake from "../../assets/photos/cakes.jpg";
import window from "../../assets/photos/story.jpg";
import { chapters } from "../../content/chapters";
const c = chapters.little;
const exhibits = [
  { name: "cups", letter: "A", title: "Five cups, arranged by height", text: "Move along the row and each one lifts off its saucer.", label: "A line drawing of five coffee cups on saucers along a tray. The cup under the pointer lifts." },
  { name: "dome", letter: "B", title: "Something under glass", text: "Raise the pointer and the dome lifts off the cake.", label: "A line drawing of a cake on a stand under a glass dome. Moving the pointer up lifts the dome." },
];
---
<section id={c.id} class="scene field-paper little" aria-labelledby={`${c.id}-title`}>
  <div class="wrap">
    <Intertitle no={c.no} label="Please take your time" id={`${c.id}-title`} title="The _little_ things." >
      <p class="dek" data-reveal style="--i:2">A visit is mostly small details. A biscuit you didn't ask for. A cake cut just so. A lamp in the window when the light goes.</p>
    </Intertitle>
    <div class="sequence">
      <Plate src={latte} alt="A close view of a round biscuit resting on a white saucer beside a cappuccino." no="6" caption="A biscuit, on the saucer." ratio="3 / 4" position="18% 62%" class="s1" />
      <Plate src={cake} alt="A raspberry and coconut sponge with cream filling, cut into slices, with an espresso machine behind." no="7" caption="Raspberry & coconut sponge." ratio="4 / 5" class="s2" />
      <Plate src={window} alt="A brass pendant lamp glowing against a dusk-blue sky through the café window." no="8" caption="The lamp, at dusk." ratio="3 / 4" position="85% 22%" class="s3" />
    </div>

    <div class="exhibits">
      {exhibits.map((e, i) => (
        <figure class="exhibit" data-reveal style={`--i:${i}`}>
          <div class="plate-fig">
            <span class="read mono" data-read-for={e.name} aria-hidden="true">rest</span>
            <div class="stage" data-figure={e.name} data-label={e.label}></div>
          </div>
          <figcaption>
            <span class="label ex">Exhibit {e.letter}</span>
            <span class="t">{e.title}</span>
            <span class="d">{e.text}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<script>
  import "../../scripts/figures.ts";
</script>
<style>
  .sequence { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: clamp(16px, 3vw, 48px); align-items: start; }
  .s1 { margin-top: var(--space-8); }
  .s3 { margin-top: var(--space-7); }
  .exhibits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 3vw, 40px); margin-top: var(--space-8); padding-top: var(--space-7); border-top: var(--double-rule); }
  .exhibit { margin: 0; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-5); align-items: center; }
  .plate-fig { position: relative; background: var(--paper); outline: 1px solid var(--rule); outline-offset: -1px; }
  .read { position: absolute; top: 10px; right: 12px; z-index: 1; color: var(--cherry); pointer-events: none; }
  .stage { width: 100%; aspect-ratio: 5 / 4; }
  figcaption { display: grid; gap: 6px; }
  .ex { color: var(--cherry); font-weight: 600; }
  .t { font: 400 24px/1.15 var(--font-serif); }
  .d { font-size: 15px; color: var(--ink-soft); }
  @media (max-width: 1100px) { .exhibit { grid-template-columns: 1fr; } }
  @media (max-width: 767px) {
    .sequence { grid-template-columns: 1fr 1fr; }
    .s2 { grid-column: 1 / -1; grid-row: 1; }
    .s1, .s3 { margin-top: 0; }
    .exhibits { grid-template-columns: 1fr; margin-top: var(--space-7); padding-top: var(--space-6); }
  }
</style>
