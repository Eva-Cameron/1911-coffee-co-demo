---
import hours from "../content/hours.json";
import site from "../content/site.json";
const time = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return `${h % 12 || 12}${m ? ":" + String(m).padStart(2, "0") : ""}${h < 12 ? "am" : "pm"}`;
};
---
<section id="find-us" class="find section field-sky" aria-labelledby="find-title">
  <div class="wrap">
    <div class="chapter">
      <p class="part">Chapter six</p>
      <h2 id="find-title" data-type data-type-speed="55">Find us</h2>
    </div>
    <div class="grid">
      <div class="where bevel" data-reveal style="--i:1">
        <h3>The address</h3>
        <address>{site.street}<br />{site.town}, Northumberland<br />{site.postcode}</address>
        <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p class="small">Ring ahead to order and skip the wait.</p>
        <a class="btn" href={site.directions} rel="noopener">Get directions</a>
        <p class="small">Dogs welcome and step-free access (to confirm).</p>
      </div>
      <div class="when bevel" data-reveal style="--i:2">
        <h3>The hours</h3>
        <table class="hours" data-hours-table>
          <caption class="visually-hidden">Opening hours</caption>
          <tbody>
            {hours.days.map((d) => (
              <tr data-day={d.day}>
                <th scope="row">{d.name}</th>
                <td>{time(d.open)} – {time(d.close)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 440px)); justify-content: center; gap: 56px; align-items: stretch; }
  .where, .when { background: var(--paper); padding: 48px 40px; display: grid; gap: 18px; justify-items: center; align-content: start; text-align: center; }
  h3 { margin-bottom: 8px; }
  address { font-style: normal; font-size: 20px; line-height: 1.5; }
  .where a:not(.btn) { color: var(--ink); font-size: 20px; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: .25em; }
  .small { font-size: 14px; color: var(--muted); }
  .hours { width: 100%; border-collapse: collapse; font-size: 17px; }
  .hours th, .hours td { padding: 9px 0; font-weight: 400; }
  .hours th { text-align: left; }
  .hours td { text-align: right; font-variant-numeric: tabular-nums; }
  .hours tr.today th, .hours tr.today td { font-weight: 600; }
  .hours tr.today th::after { content: " · today"; font-weight: 400; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 24px; max-width: 480px; margin-inline: auto; }
    .where, .when { padding: 36px 24px; }
  }
</style>
<script>
  const table = document.querySelector<HTMLTableElement>("[data-hours-table]");
  if (table) {
    const name = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", weekday: "short" }).format(new Date());
    const iso = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].indexOf(name) + 1;
    table.querySelector(`tr[data-day="${iso}"]`)?.classList.add("today");
  }
</script>
