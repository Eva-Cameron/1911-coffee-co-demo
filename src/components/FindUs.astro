---
/* The address, the telephone and the hours. Closed days stay in the table and say so. */
import ChapterHead from "./ChapterHead.astro";
import hours from "../content/hours.json";
import site from "../content/site.json";
type Day = { day: number; name: string; open?: string; close?: string; closed?: boolean };
const time = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return `${h % 12 || 12}${m ? ":" + String(m).padStart(2, "0") : ""}${h < 12 ? "am" : "pm"}`;
};
const days = hours.days as Day[];
---
<section id="find-us" class="chapter field-sky" aria-labelledby="find-title">
  <div class="wrap">
    <ChapterHead label="Find us" id="find-title" title="Your table is waiting. <em>Probably.</em>"
      lede="On Queen Street, in the middle of Amble." />
    <div class="grid">
      <div class="card" data-reveal>
        <h3>The address</h3>
        <address>{site.street}<br />{site.town}, Northumberland<br />{site.postcode}</address>
        <p class="phone"><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p class="small">{site.orderNote} Call to reserve a table, too.</p>
        <a class="btn" href={site.directions} rel="noopener">Get directions</a>
      </div>
      <div class="card" data-reveal style="--i:1">
        <h3>The hours</h3>
        <table class="hours" data-hours-table>
          <caption class="visually-hidden">Opening hours</caption>
          <tbody>
            {days.map((d) => (
              <tr data-day={d.day} class:list={{ closed: d.closed }}>
                <th scope="row">{d.name}</th>
                <td>{d.closed ? "Closed" : `${time(d.open!)} – ${time(d.close!)}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 420px)); justify-content: center; gap: clamp(24px, 3vw, 40px); align-items: stretch; }
  .card { background: var(--paper); padding: 40px 30px; display: grid; gap: 14px; justify-items: center; align-content: start; text-align: center; }
  h3 { font-size: 26px; margin-bottom: 4px; }
  address { font-style: normal; font-size: 19px; line-height: 1.5; }
  .phone a { color: var(--espresso); font: 500 20px/1 var(--font-mono); text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .small { font-size: 14px; color: var(--muted); max-width: 28ch; }
  .hours { width: 100%; border-collapse: collapse; font-size: 16px; }
  .hours th, .hours td { padding: 8px 0; font-weight: 400; }
  .hours tr + tr th, .hours tr + tr td { box-shadow: 0 -1px 0 rgb(51 38 34 / .12); }
  .hours th { text-align: left; }
  .hours td { text-align: right; font-family: var(--font-mono); font-size: 14px; }
  .hours tr.closed td { color: var(--orange-ink); }
  .hours tr.today th, .hours tr.today td { font-weight: 700; }
  .hours tr.today th::after { content: " · today"; font-weight: 400; color: var(--muted); }
  @media (max-width: 760px) { .grid { grid-template-columns: minmax(0, 480px); } }
</style>

<script>
  const table = document.querySelector<HTMLTableElement>("[data-hours-table]");
  if (table) {
    const name = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", weekday: "short" }).format(new Date());
    const iso = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].indexOf(name) + 1;
    table.querySelector(`tr[data-day="${iso}"]`)?.classList.add("today");
  }
</script>
