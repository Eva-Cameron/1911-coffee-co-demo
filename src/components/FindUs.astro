---
import hours from "../content/hours.json";
import site from "../content/site.json";
const time = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return `${h % 12 || 12}${m ? ":" + String(m).padStart(2, "0") : ""}${h < 12 ? "am" : "pm"}`;
};
---
<section id="find-us" class="find section" aria-labelledby="find-title">
  <div class="wrap grid">
    <div class="where">
      <h2 id="find-title" data-type data-type-speed="45">Find us</h2>
      <address data-reveal style="--i:1">{site.street}<br />{site.town} {site.postcode}</address>
      <p class="call" data-reveal style="--i:2"><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      <p class="ring" data-reveal style="--i:3">Ring ahead to order and skip the wait.</p>
      <a class="btn" href={site.directions} rel="noopener" data-reveal style="--i:4">Get directions</a>
      <p class="todo" data-reveal style="--i:5">Dogs welcome and step-free access (to confirm).</p>
    </div>
    <table class="hours" data-hours-table data-reveal style="--i:2">
      <caption>Opening hours</caption>
      <tbody>
        {hours.days.map((d) => (
          <tr data-day={d.day}>
            <th scope="row">{d.name}</th>
            <td>{time(d.open)} – {time(d.close)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 80px; align-items: start; }
  .where { display: grid; gap: 22px; justify-items: start; }
  address { font-style: normal; font-size: 22px; line-height: 1.3; }
  .call a { font-size: 22px; color: var(--ink); text-decoration-color: var(--orange); text-decoration-thickness: 2px; }
  .ring, .todo { font-size: 17px; color: var(--muted); }
  .todo { color: var(--ember); }
  .hours { width: 100%; border-collapse: collapse; font-size: 17px; background: var(--paper); }
  caption { text-align: left; font-weight: 700; font-size: 22px; padding-bottom: 18px; }
  .hours th, .hours td { padding: 14px 24px; text-align: left; font-weight: 400; }
  .hours td { text-align: right; font-variant-numeric: tabular-nums; }
  .hours tr:first-child th, .hours tr:first-child td { padding-top: 24px; }
  .hours tr:last-child th, .hours tr:last-child td { padding-bottom: 24px; }
  .hours tr.today th, .hours tr.today td { font-weight: 700; color: var(--ember); }
  .hours tr.today th::after { content: " (today)"; font-weight: 400; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 48px; }
    .hours th, .hours td { padding-inline: 16px; }
  }
</style>
<script>
  const table = document.querySelector<HTMLTableElement>("[data-hours-table]");
  if (table) {
    const name = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", weekday: "short" }).format(new Date());
    const iso = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].indexOf(name) + 1;
    table.querySelector(`tr[data-day="${iso}"]`)?.classList.add("today");
  }
</script>
