---
import { Picture } from "astro:assets";
import hours from "../content/hours.json";
import site from "../content/site.json";
import findus from "../assets/photos/findus.jpg";
const fmt = (t: string) => t.replace(/^0/, "");
---
<section id="find-us" class="find section" aria-labelledby="find-title">
  <div class="wrap grid">
    <div class="info">
      <p class="kicker" data-type>No. 05 — Find us</p>
      <h2 id="find-title" class="ink">On Queen Street, Amble</h2>
      <address class="type">
        {site.name}<br />{site.street}<br />{site.town} {site.postcode}<br />
        <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </address>
      <table class="hours" data-hours-table>
        <caption class="caps">Opening hours</caption>
        <tbody>
          {hours.days.map((d) => (
            <tr data-day={d.day}>
              <th scope="row">{d.name}</th>
              <td class="type">{fmt(d.open)} – {fmt(d.close)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="notes">
        <li>Dogs welcome inside.</li>
        <li>Step-free entrance. <span class="todo">(Confirm with Joseph.)</span></li>
      </ul>
    </div>
    <a class="map" href={site.directions} rel="noopener" data-reveal>
      <Picture src={findus} alt="" widths={[600, 1000]} sizes="(max-width: 767px) 100vw, 520px" formats={["avif", "webp"]} loading="lazy" />
      <span class="pill">Get directions</span>
      <span class="visually-hidden">Open directions to {site.name} in Google Maps</span>
    </a>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--space-6); align-items: center; }
  .info { display: grid; gap: var(--space-4); justify-items: start; }
  .info .kicker { margin-bottom: calc(-1 * var(--space-2)); }
  address { font-style: normal; font-size: 17px; line-height: 1.55; }
  .hours { border-collapse: collapse; width: 100%; max-width: 380px; }
  .hours caption { text-align: left; padding-bottom: var(--space-2); }
  .hours th, .hours td { padding: 8px 0; border-bottom: 1px dashed rgb(45 42 38 / .25); text-align: left; font-weight: 400; }
  .hours td { text-align: right; font-variant-numeric: tabular-nums; }
  .hours tr.today th, .hours tr.today td { font-weight: 700; }
  .hours tr.today th::before { content: "▸ "; color: var(--ember); }
  .notes { margin: 0; padding-left: 1.1em; font-size: 15px; }
  .todo { color: var(--ember); }
  .map { position: relative; display: block; border-radius: var(--radius-photo); overflow: hidden; aspect-ratio: 4 / 3.4; box-shadow: var(--shadow-photo); rotate: 1.5deg; transition: rotate .8s var(--ease-out); }
  .map:hover { rotate: 0deg; }
  .map :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .map .pill { position: absolute; right: 20px; bottom: 20px; }
  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; gap: var(--space-5); } .map { rotate: 0deg; } }
</style>
<script>
  const iso = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].indexOf(
    new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", weekday: "short" }).format(new Date())) + 1;
  document.querySelector(`[data-hours-table] tr[data-day="${iso}"]`)?.classList.add("today");
</script>
