---
/* The wordmark: a marquee "1911" over a small, tracked "Coffee Co.", with a coffee bean set between two rules. */
interface Props { size?: "sm" | "md" | "lg"; class?: string; }
const { size = "md", class: cls } = Astro.props;
---
<span class:list={["wordmark", `wordmark--${size}`, cls]}>
  <span class="num">1911</span>
  <span class="desc">
    <span class="bar" aria-hidden="true"></span>
    <span class="txt">Coffee Co.</span>
    <svg class="bean" viewBox="0 0 12 16" aria-hidden="true"><ellipse cx="6" cy="8" rx="5" ry="7" fill="currentColor"/><path d="M6 1.5 C 3.5 5, 8.5 11, 6 14.5" fill="none" stroke="var(--wm-ground, #F8F0DF)" stroke-width="1.3" stroke-linecap="round"/></svg>
    <span class="bar" aria-hidden="true"></span>
  </span>
</span>

<style>
  .wordmark { display: inline-grid; justify-items: center; line-height: 1; color: inherit; }
  .num { font-family: var(--font-sign); letter-spacing: .04em; }
  .desc { display: flex; align-items: center; gap: .5em; font: 600 .2em/1 var(--font-sans); letter-spacing: .32em; text-transform: uppercase; margin-top: .28em; }
  .txt { padding-left: .32em; }
  .bar { width: 1.6em; height: 1px; background: currentColor; opacity: .7; }
  .bean { width: .7em; height: .9em; flex: none; order: -1; display: none; }
  .wordmark--sm { font-size: 34px; }
  .wordmark--md { font-size: 56px; }
  .wordmark--lg { font-size: clamp(56px, 8vw, 104px); }
  .wordmark--lg .bean { display: block; order: 0; }
  .wordmark--sm .desc { font-size: .23em; letter-spacing: .26em; }
</style>
