---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import story from "../assets/photos/story.jpg";
import menu from "../assets/photos/menu.jpg";
import findus from "../assets/photos/findus.jpg";
const tiles = [
  { href: "#story", label: "Our Story", note: "Since 2019", src: story, alt: "Placeholder for a photo of the orange shopfront on Queen Street" },
  { href: "#menu", label: "Menu", note: "Brunch · Lunch · Cakes", src: menu, alt: "Placeholder for a photo of the menu board" },
  { href: "#find-us", label: "Find Us", note: "Queen St, Amble", src: findus, alt: "Placeholder for a photo of Queen Street, Amble" },
];
---
<section class="tiles wrap" aria-label="Explore">
  {tiles.map((t, i) => (
    <a class="tile" href={t.href} data-reveal style={`--i:${i}`}>
      <Picture src={t.src} alt={t.alt} widths={[400, 800, 1200]} sizes="(max-width: 767px) 100vw, 390px" formats={["avif", "webp"]} loading="lazy" />
      <span class="label">
        <span class="no type">0{i + 1}</span>
        <span class="text"><strong>{t.label}</strong><span>{t.note}</span></span>
        <span class="go"><Icon name="arrow-right" weight="bold" size={18} /></span>
      </span>
    </a>
  ))}
</section>
<style>
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); padding-bottom: var(--space-7); }
  .tile {
    position: relative; display: block; aspect-ratio: 4 / 4.6;
    border-radius: var(--radius-card); overflow: hidden; background: var(--oak);
    box-shadow: var(--shadow-card); text-decoration: none; color: var(--ink);
    transition: box-shadow .2s, transform .2s;
  }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  .tile:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .tile:hover :global(img) { transform: scale(1.04); }
  .tile:active { transform: translateY(0); }
  .label {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    display: flex; align-items: center; gap: 12px;
    padding: 10px 10px 10px 14px;
    background: var(--paper); border-radius: var(--radius-control);
    box-shadow: var(--shadow-card);
  }
  .no { font-size: 12px; color: var(--ember); }
  .text { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .text strong { font-size: 16px; font-weight: 680; letter-spacing: -.01em; }
  .text span { font-size: 13px; color: var(--muted); }
  .go {
    display: grid; place-items: center; width: 36px; height: 36px; flex: none;
    border-radius: 8px; background: var(--orange); color: var(--ink);
    transition: transform .2s var(--ease-out), background .15s;
  }
  .tile:hover .go { transform: translateX(2px); background: var(--orange-hover); }
  @media (max-width: 767px) {
    .tiles { grid-template-columns: 1fr; padding-bottom: var(--space-6); gap: var(--space-3); }
    .tile { aspect-ratio: 16 / 10; }
  }
</style>
