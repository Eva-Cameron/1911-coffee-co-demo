---
/** A Phosphor icon (fill or bold weight), inlined. Decorative unless given a label. */
interface Props { name: string; weight?: "fill" | "bold"; size?: number; label?: string; class?: string; }
const { name, weight = "fill", size = 20, label, class: cls } = Astro.props;
const all = import.meta.glob("/node_modules/@phosphor-icons/core/assets/{fill,bold}/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const raw = all[`/node_modules/@phosphor-icons/core/assets/${weight}/${name}-${weight}.svg`];
if (!raw) throw new Error(`Icon not found: ${name} (${weight})`);
const inner = raw.replace(/^<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 256 256" fill="currentColor"
  role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} focusable="false" set:html={inner} />
