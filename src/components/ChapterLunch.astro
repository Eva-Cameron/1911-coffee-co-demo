---
import ChapterHead from "./ChapterHead.astro";
import Plate from "./Plate.astro";
import sandwich from "../assets/photos/menu.jpg";
import salad from "../assets/photos/salad.jpg";
import menu from "../content/menu.json";
const lunch = menu.sections.find((s) => s.id === "lunch")!;
---
<section id="lunch" class="chapter field-sky" aria-labelledby="lunch-title">
  <div class="wrap split">
    <div class="photos">
      <Plate class="big" src={sandwich} ratio="1 / 1"
        alt="A sandwich cut in half on a black slate with coleslaw, beetroot and a dressed salad" />
      <Plate class="small" src={salad} ratio="1 / 1" sizes="(max-width: 767px) 60vw, 260px" i={1}
        alt="A salad plate with beetroot, pickled red cabbage, tomato and red onion" />
    </div>
    <div class="copy">
      <ChapterHead label="Lunch" id="lunch-title" align="start"
        title="A little something for the middle of the day." />
      <p class="lede" data-reveal>{lunch.note}</p>
      <ul class="kinds">
        {lunch.items.map((it, i) => (
          <li data-reveal style={`--i:${i}`}><span class="name">{it.name}</span>{it.desc && <span class="desc">{it.desc}</span>}</li>
        ))}
      </ul>
      <p data-reveal><a class="link" href="#menu">The full menu</a></p>
      <p class="label allergy" data-reveal>{menu.allergy}</p>
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(40px, 7vw, 96px); align-items: center; }
  .photos { position: relative; padding-bottom: 22%; }
  .photos :global(.big) { width: 82%; }
  .photos :global(.small) { position: absolute; right: 0; bottom: 0; width: 46%; }
  .lede { font-size: var(--step-lead); line-height: 1.45; margin-bottom: 20px; max-width: 40ch; }
  .kinds { display: grid; margin-bottom: 26px; }
  .kinds li { display: grid; gap: 2px; padding: 11px 0; }
  .kinds li + li { box-shadow: 0 -1px 0 rgb(51 38 34 / .2); }
  .name { font: 600 var(--step-lead)/1.25 var(--font-head); font-variation-settings: "SOFT" 100; }
  .desc { color: var(--muted); font-size: 15px; }
  .allergy { margin-top: 18px; color: var(--muted); }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
</style>
