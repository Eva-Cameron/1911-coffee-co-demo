---
/* Amble itself: the harbour, the island, the beaches, the river. Facts from Visit Northumberland, read 30 Oct 2026. */
import ChapterHead from "./ChapterHead.astro";
const things = [
  { title: "The harbour", text: "Wooden pods in the Harbour Village, boats in the marina, and seafood with a view of the water." },
  { title: "Coquet Island", text: "An RSPB seabird reserve about a mile offshore. Puffins come back to breed in spring, and boat trips leave from the harbour." },
  { title: "The beaches", text: "Little Shore between the pier and the promenade, and the dunes of Amble Links looking out to the island." },
  { title: "Up the river", text: "Follow the Coquet inland to Warkworth and its castle." },
];
---
<section id="amble" class="chapter field-cream" aria-labelledby="amble-title">
  <div class="wrap split">
    <!-- Coquet Island and its lighthouse, drawn for the site -->
    <svg class="scene" overflow="hidden" viewBox="0 0 400 300" role="img" aria-label="A drawing of Coquet Island and its lighthouse across the water">
      <rect width="400" height="300" fill="var(--sky)"/>
      <circle cx="306" cy="78" r="34" fill="var(--custard)"/>
      <path d="M70 196 q40 -30 96 -26 q20 -22 40 -6 q60 -6 110 32 z" fill="var(--mint)" stroke="var(--espresso)" stroke-width="3" stroke-linejoin="round"/>
      <g stroke="var(--espresso)" stroke-width="3" stroke-linejoin="round">
        <path d="M178 172 l4 -70 h14 l4 70 z" fill="var(--cream)"/>
        <path d="M180 132 h18" />
        <rect x="181" y="88" width="16" height="14" fill="var(--custard)"/>
        <path d="M177 88 l12 -12 l12 12 z" fill="var(--orange)"/>
      </g>
      <g class="sea" fill="none" stroke="var(--espresso)" stroke-width="3" stroke-linecap="round">
        <path d="M-20 218 q20 -10 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0"/>
        <path d="M-20 250 q20 -10 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0"/>
      </g>
      <path d="M0 272 h400 v28 h-400 z" fill="var(--orange)"/>
    </svg>
    <div class="copy">
      <ChapterHead label="Amble" id="amble-title" align="start"
        title="The friendliest port in England." lede="Amble sits where the River Coquet meets the sea, at the southern end of the Northumberland coast." />
      <ul class="things">
        {things.map((t, i) => (
          <li data-reveal style={`--i:${i}`}><h3>{t.title}</h3><p>{t.text}</p></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(40px, 7vw, 96px); align-items: center; }
  .scene { width: 100%; height: auto; display: block; }
  :global(.motion) .sea { animation: drift 6s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translateX(-20px); } }
  .things { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 36px; }
  .things li { display: grid; gap: 6px; align-content: start; }
  h3 { font-size: 22px; }
  .things p { color: var(--muted); }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .things { grid-template-columns: 1fr; } }
</style>
