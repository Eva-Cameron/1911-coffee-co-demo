---
import Roundel from "./Roundel.astro";
import Icon from "./Icon.astro";
const links = [
  { href: "#menu", label: "Menu" },
  { href: "#story", label: "Our Story" },
  { href: "#counter", label: "Suppliers" },
  { href: "#reviews", label: "Reviews" },
];
---
<header class="header">
  <nav class="left" aria-label="Main">
    <ul>
      {links.map((l) => <li><a class="nav-link" href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <a class="mark" href="/" aria-label="1911 Coffee Co., home">
    <Roundel size={60} class="stamp" />
  </a>

  <div class="right">
    <a class="nav-link find" href="#find-us"><Icon name="map-pin" size={18} />Find us</a>
    <a class="btn" href="#menu"><Icon name="coffee" size={18} />Today's menu</a>
    <button class="btn btn--light menu-btn" type="button" aria-expanded="false" aria-controls="sheet">
      <Icon name="list" weight="bold" size={20} />Menu
    </button>
  </div>
</header>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="sheet-top">
    <Roundel size={48} />
    <button class="btn btn--light close" type="button">
      <Icon name="x" weight="bold" size={18} />Close
    </button>
  </div>
  <ul>
    {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href}>{l.label}<Icon name="arrow-right" weight="bold" size={20} /></a></li>)}
    <li style="--i:4"><a href="#find-us">Find us<Icon name="arrow-right" weight="bold" size={20} /></a></li>
  </ul>
  <a class="btn sheet-call" href="tel:+441665710706"><Icon name="phone" size={18} />Call 01665 710706</a>
</div>

<style>
  .header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 72px;
    padding: 0 var(--space-5);
    position: relative;
    z-index: 5;
    border-bottom: 1px solid var(--line);
  }
  .left ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 40px; padding: 0 12px;
    border-radius: var(--radius-control);
    color: var(--ink); text-decoration: none;
    font: 600 15px/1 var(--font-sans);
    transition: background .15s, color .15s;
  }
  .nav-link:hover { background: rgb(255 243 228 / .1); color: var(--ink); }
  .nav-link:active, .nav-link[aria-current] { background: rgb(255 243 228 / .18); }
  .nav-link :global(.icon) { color: var(--ember); }
  .mark { display: block; border-radius: 50%; }
  .right { display: flex; justify-content: flex-end; align-items: center; gap: var(--space-2); }
  .menu-btn { display: none; }

  .sheet {
    position: fixed; inset: 0; z-index: 50;
    background: var(--cream);
    padding: var(--space-4);
    display: flex; flex-direction: column; gap: var(--space-5);
  }
  .sheet[hidden] { display: none; }
  .sheet-top { display: flex; justify-content: space-between; align-items: center; }
  .sheet ul { list-style: none; margin: 0 0 auto; padding: 0; display: grid; gap: var(--space-2); }
  .sheet li a {
    display: flex; justify-content: space-between; align-items: center;
    min-height: 56px; padding: 0 var(--space-4);
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    font: 680 22px/1 var(--font-sans); letter-spacing: -.015em;
    color: var(--ink); text-decoration: none;
  }
  .sheet li a :global(.icon) { color: var(--ember); }
  .sheet li a:active { background: var(--wash); }
  .sheet-call { width: 100%; min-height: 52px; }
  :global(.motion) .sheet:not([hidden]) li { animation: sheet-in .4s var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 1023px) {
    .left, .find, .right > .btn:not(.menu-btn) { display: none; }
    .menu-btn { display: inline-flex; }
    .header { grid-template-columns: auto 1fr; padding: 0 var(--space-4); height: 68px; }
    .mark :global(svg) { width: 46px; height: 46px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
  const sheet = document.getElementById("sheet")!;
  const close = sheet.querySelector<HTMLButtonElement>(".close")!;
  const focusables = () => [...sheet.querySelectorAll<HTMLElement>("a, button")];

  function open() {
    sheet.hidden = false;
    btn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    close.focus();
  }
  function shut(restore = true) {
    sheet.hidden = true;
    btn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    if (restore) btn.focus();
  }
  btn.addEventListener("click", open);
  close.addEventListener("click", () => shut());
  sheet.addEventListener("click", (e) => { if ((e.target as Element).closest("li a")) shut(false); });
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return shut();
    if (e.key !== "Tab") return;
    const f = focusables(), first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // Active state: the nav link for the section in view
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".header .nav-link[href^='#']")];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      navLinks.forEach((a) => a.getAttribute("href") === "#" + e.target.id ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
    }
  }, { rootMargin: "-45% 0px -50% 0px" });
  navLinks.forEach((a) => { const t = document.querySelector(a.getAttribute("href")!); if (t) io.observe(t); });
</script>
