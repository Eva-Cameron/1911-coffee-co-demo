---
import Roundel from "./Roundel.astro";
import Icon from "./Icon.astro";
import site from "../content/site.json";
const left = [{ href: "#story", label: "Our story" }, { href: "#menu", label: "Menu" }];
const right = [{ href: "#reviews", label: "Reviews" }, { href: "#find-us", label: "Find us" }];
const links = [...left, ...right];
---
<header class="header wrap">
  <nav class="side side-left" aria-label="Main">
    <ul>{left.map((l) => <li><a class="nav-link" href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <a class="mark" href="/" aria-label="1911 Coffee Co., home">
    <Roundel size={60} class="stamp" />
  </a>
  <nav class="side side-right" aria-label="More">
    <ul>{right.map((l) => <li><a class="nav-link" href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <button class="btn menu-btn" type="button" aria-expanded="false" aria-controls="sheet">Menu</button>
</header>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="sheet-top">
    <Roundel size={48} />
    <button class="btn close" type="button"><Icon name="x" weight="bold" size={16} />Close</button>
  </div>
  <ul>
    {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>)}
  </ul>
  <a class="btn sheet-call" href={`tel:${site.phoneHref}`}>Call {site.phone}</a>
</div>

<style>
  .header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 96px; position: relative; z-index: 5; }
  .side ul { display: flex; gap: 40px; list-style: none; margin: 0; padding: 0; }
  .side-left ul { justify-content: flex-end; padding-right: 48px; }
  .side-right ul { justify-content: flex-start; padding-left: 48px; }
  .nav-link { color: var(--ink); text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; padding: 10px 0; text-underline-offset: .5em; text-decoration-thickness: 2px; text-decoration-color: var(--maroon); }
  .nav-link:hover, .nav-link[aria-current] { text-decoration-line: underline; }
  .mark { display: block; border-radius: 50%; }
  .menu-btn { display: none; }

  .sheet { position: fixed; inset: 0; z-index: 50; background: var(--stone); padding: 20px; display: flex; flex-direction: column; gap: 32px; }
  .sheet[hidden] { display: none; }
  .sheet-top { display: flex; justify-content: space-between; align-items: center; }
  .sheet ul { list-style: none; margin: 0 0 auto; padding: 0; display: grid; gap: 4px; text-align: center; }
  .sheet li a { display: block; padding: 14px 0; font-size: 26px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); text-decoration: none; }
  .sheet-call { width: 100%; }
  :global(.motion) .sheet:not([hidden]) li { animation: sheet-in .4s var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 900px) {
    .side { display: none; }
    .header { grid-template-columns: auto 1fr auto; height: 80px; }
    .mark { grid-column: 1; }
    .menu-btn { display: inline-flex; grid-column: 3; min-height: 44px; padding: 0 18px; }
    .mark :global(svg) { width: 52px; height: 52px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
  const sheet = document.getElementById("sheet")!;
  const close = sheet.querySelector<HTMLButtonElement>(".close")!;
  const focusables = () => [...sheet.querySelectorAll<HTMLElement>("a, button")];

  function open() {
    sheet.hidden = false;
    btn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    close.focus();
  }
  function shut(restore = true) {
    sheet.hidden = true;
    btn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    if (restore) btn.focus();
  }
  btn.addEventListener("click", open);
  close.addEventListener("click", () => shut());
  sheet.addEventListener("click", (e) => { if ((e.target as Element).closest("li a")) shut(false); });
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return shut();
    if (e.key !== "Tab") return;
    const f = focusables(), first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // Active state: the nav link for the section in view
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".header .nav-link[href^='#']")];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      navLinks.forEach((a) => a.getAttribute("href") === "#" + e.target.id ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
    }
  }, { rootMargin: "-45% 0px -50% 0px" });
  navLinks.forEach((a) => { const t = document.querySelector(a.getAttribute("href")!); if (t) io.observe(t); });
</script>
