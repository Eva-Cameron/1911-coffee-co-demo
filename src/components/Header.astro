---
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";
import site from "../content/site.json";
const left = [{ href: "#coffee", label: "Coffee" }, { href: "#breakfast", label: "Breakfast" }];
const right = [{ href: "#menu", label: "Menu" }, { href: "#find-us", label: "Find us" }];
const all = [...left, { href: "#lunch", label: "Lunch" }, ...right, { href: "#visitors", label: "Reviews" }];
---
<header class="header wrap intro-fade" style="--d:0ms">
  <nav class="side side-left" aria-label="Main">
    <ul>{left.map((l) => <li><a class="link nav-link" href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <a class="mark" href="/" aria-label="1911 Coffee Co., home"><Wordmark size="sm" /></a>
  <nav class="side side-right" aria-label="Visit">
    <ul>{right.map((l) => <li><a class="link nav-link" href={l.href}>{l.label}</a></li>)}</ul>
  </nav>
  <button class="btn btn--ink menu-btn" type="button" aria-expanded="false" aria-controls="sheet">Menu</button>
</header>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="sheet-top">
    <Wordmark size="sm" />
    <button class="btn btn--ink close" type="button"><Icon name="x" weight="bold" size={16} />Close</button>
  </div>
  <ul>
    {all.map((l, i) => <li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>)}
  </ul>
  <a class="btn sheet-call" href={`tel:${site.phoneHref}`}>Call {site.phone}</a>
</div>

<style>
  .header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 104px; position: relative; z-index: 5; }
  .side ul { display: flex; gap: 36px; }
  .side-left ul { justify-content: flex-end; padding-right: 52px; }
  .side-right ul { justify-content: flex-start; padding-left: 52px; }
  .nav-link { font-size: 13px; letter-spacing: .18em; }
  .nav-link::after { transform: scaleX(0); }
  .nav-link:hover::after, .nav-link[aria-current]::after { transform: scaleX(1); }
  .mark { display: block; color: var(--espresso); text-decoration: none; --wm-ground: var(--orange); }
  .mark:hover { color: var(--espresso); }
  .menu-btn { display: none; }

  .sheet { position: fixed; inset: 0; z-index: 50; background: var(--cream); padding: 20px; display: flex; flex-direction: column; gap: 32px; }
  .sheet[hidden] { display: none; }
  .sheet-top { display: flex; justify-content: space-between; align-items: center; }
  .sheet ul { margin: 0 0 auto; display: grid; gap: 2px; text-align: center; }
  .sheet li a { display: block; padding: 12px 0; font: 600 34px/1.1 var(--font-head); font-variation-settings: "SOFT" 100; color: var(--espresso); text-decoration: none; }
  .sheet-call { width: 100%; }
  :global(.motion) .sheet:not([hidden]) li { animation: sheet-in .45s var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 900px) {
    .side { display: none; }
    .header { grid-template-columns: auto 1fr auto; height: 84px; }
    .mark { grid-column: 1; }
    .menu-btn { display: inline-flex; grid-column: 3; min-height: 44px; padding: 0 18px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
  const sheet = document.getElementById("sheet")!;
  const close = sheet.querySelector<HTMLButtonElement>(".close")!;
  const focusables = () => [...sheet.querySelectorAll<HTMLElement>("a, button")];
  const open = () => { sheet.hidden = false; btn.setAttribute("aria-expanded", "true"); document.body.style.overflow = "hidden"; close.focus(); };
  const shut = (restore = true) => { sheet.hidden = true; btn.setAttribute("aria-expanded", "false"); document.body.style.overflow = ""; if (restore) btn.focus(); };
  btn.addEventListener("click", open);
  close.addEventListener("click", () => shut());
  sheet.addEventListener("click", (e) => { if ((e.target as Element).closest("li a")) shut(false); });
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return shut();
    if (e.key !== "Tab") return;
    const list = focusables(), first = list[0], last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  // The nav link for the chapter in view
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".header .nav-link[href^='#']")];
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      navLinks.forEach((a) => a.getAttribute("href") === "#" + entry.target.id ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
    }
  }, { rootMargin: "-45% 0px -50% 0px" });
  navLinks.forEach((a) => { const target = document.querySelector(a.getAttribute("href")!); if (target) io.observe(target); });
</script>
