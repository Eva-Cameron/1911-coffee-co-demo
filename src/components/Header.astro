---
/**
 * The header: a slim printed band. Desktop has three chapter links each side of the wordmark;
 * phones get the wordmark, a Contents button that opens the chapter list, and a pocket bar
 * fixed at the bottom with the three things people come for: the menu, directions, a phone call.
 */
import Wordmark from "./Wordmark.astro";
import site from "../content/site.json";
import { chapters } from "../content/chapters";
const left = [chapters.coffee, chapters.breakfast, chapters.lunch];
const right = [chapters.visitors, chapters.menu];
---
<header class="header" data-header>
  <div class="bar wrap intro-nav">
    <nav class="side side-left" aria-label="Chapters">
      <ul>{left.map((c) => <li><a class="nav-link" href={`#${c.id}`}>{c.short}</a></li>)}</ul>
    </nav>
    <a class="home intro-wordmark" href="#top" aria-label="1911 Coffee Co., back to the top"><Wordmark size="sm" /></a>
    <nav class="side side-right" aria-label="Visit">
      <ul>
        {right.map((c) => <li><a class="nav-link" href={`#${c.id}`}>{c.short}</a></li>)}
        <li><a class="btn btn--small" href={`#${chapters.visit.id}`}>Find us</a></li>
      </ul>
    </nav>
    <button class="btn btn--paper contents-btn" type="button" aria-expanded="false" aria-controls="contents">Contents</button>
  </div>
</header>

<div class="contents field-cream" id="contents" role="dialog" aria-modal="true" aria-labelledby="contents-title" hidden>
  <div class="contents-top">
    <Wordmark size="sm" />
    <button class="btn btn--paper close" type="button">Close</button>
  </div>
  <p id="contents-title" class="label contents-title">Contents</p>
  <ol>
    {Object.values(chapters).filter((c) => c.no).map((c, i) => (
      <li style={`--i:${i}`}><a href={`#${c.id}`}><span class="display num">{c.no}</span><span class="t">{c.title}</span></a></li>
    ))}
  </ol>
  <p class="mono contents-foot">{site.street}, {site.town} · <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
</div>

<nav class="pocket" aria-label="Quick actions">
  <a href={`#${chapters.menu.id}`}>Menu</a>
  <a href={site.directions} rel="noopener">Directions</a>
  <a href={`tel:${site.phoneHref}`}>Call</a>
</nav>

<style>
  .header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--cream) 94%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-mid);
  }
  .header[data-scrolled] { border-bottom-color: var(--rule); }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 72px; }
  .side ul { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 36px); list-style: none; }
  .side-left ul { justify-content: flex-start; }
  .side-right ul { justify-content: flex-end; }
  .nav-link {
    position: relative; display: inline-block; padding: 12px 0;
    color: var(--espresso); text-decoration: none;
    font: 500 12.5px/1 var(--font-sans); letter-spacing: var(--tracking-caps); text-transform: uppercase;
  }
  .nav-link::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 6px; height: 1px; background: var(--cherry);
    transform: scaleX(0); transition: transform var(--dur-mid) var(--ease-settle);
  }
  .nav-link:hover::after, .nav-link[aria-current]::after { transform: scaleX(1); }
  .home { color: inherit; text-decoration: none; padding: 6px 8px; }
  .btn--small { min-height: 40px; padding: 0 18px; font-size: 12.5px; }
  .contents-btn { display: none; min-height: 40px; padding: 0 16px; font-size: 12.5px; }

  .contents { position: fixed; inset: 0; z-index: 60; display: flex; flex-direction: column; padding: 16px var(--gutter) 24px; overflow-y: auto; }
  .contents[hidden] { display: none; }
  .contents-top { display: flex; justify-content: space-between; align-items: center; min-height: 56px; }
  .contents-title { margin: var(--space-6) 0 var(--space-3); color: var(--cherry); text-align: center; }
  .contents ol { list-style: none; display: grid; margin-bottom: auto; border-top: var(--hairline); }
  .contents li a {
    display: grid; grid-template-columns: 56px 1fr; align-items: baseline; gap: 12px;
    padding: 14px 4px; border-bottom: var(--hairline);
    color: var(--espresso); text-decoration: none;
  }
  .contents .num { color: var(--cherry); font-size: 17px; }
  .contents .t { font: 400 22px/1.15 var(--font-serif); }
  .contents-foot { margin-top: var(--space-5); text-align: center; }
  :global(.motion) .contents:not([hidden]) li { animation: fade-in .45s ease-out both; animation-delay: calc(var(--i) * 40ms); }

  .pocket { display: none; }

  @media (max-width: 960px) {
    .side { display: none; }
    .bar { grid-template-columns: auto 1fr auto; height: 64px; }
    .home { grid-column: 1; padding-left: 0; }
    .contents-btn { display: inline-flex; grid-column: 3; }
  }
  @media (max-width: 767px) {
    .pocket {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
      display: grid; grid-template-columns: repeat(3, 1fr);
      background: var(--espresso);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .pocket a {
      display: grid; place-items: center; min-height: 52px;
      color: var(--cream); text-decoration: none;
      font: 600 12.5px/1 var(--font-sans); letter-spacing: var(--tracking-caps); text-transform: uppercase;
    }
    .pocket a + a { border-left: 1px solid rgb(248 240 223 / .2); }
    .pocket a:active { background: var(--cherry); }
    .pocket a:focus-visible { outline-color: var(--custard); outline-offset: -4px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const onScroll = () => header.toggleAttribute("data-scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const btn = document.querySelector<HTMLButtonElement>(".contents-btn")!;
  const sheet = document.getElementById("contents")!;
  const close = sheet.querySelector<HTMLButtonElement>(".close")!;
  const focusables = () => [...sheet.querySelectorAll<HTMLElement>("a, button")];
  function open() { sheet.hidden = false; btn.setAttribute("aria-expanded", "true"); document.body.style.overflow = "hidden"; close.focus(); }
  function shut(restore = true) { sheet.hidden = true; btn.setAttribute("aria-expanded", "false"); document.body.style.overflow = ""; if (restore) btn.focus(); }
  btn.addEventListener("click", open);
  close.addEventListener("click", () => shut());
  sheet.addEventListener("click", (e) => { if ((e.target as Element).closest("li a")) shut(false); });
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return shut();
    if (e.key !== "Tab") return;
    const f = focusables(), first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // The link for the chapter in view takes the underline
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".header .nav-link")];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      links.forEach((a) => a.getAttribute("href") === "#" + e.target.id ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
    }
  }, { rootMargin: "-45% 0px -50% 0px" });
  links.forEach((a) => { const t = document.querySelector(a.getAttribute("href")!); if (t) io.observe(t); });
</script>
