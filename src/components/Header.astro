---
import Roundel from "./Roundel.astro";
import Icon from "./Icon.astro";
import site from "../content/site.json";
const links = [
  { href: "#menu", label: "Menu" },
  { href: "#story", label: "Our story" },
  { href: "#reviews", label: "Reviews" },
  { href: "#find-us", label: "Find us" },
];
---
<header class="header wrap">
  <a class="mark" href="/" aria-label="1911 Coffee Co., home">
    <Roundel size={56} class="stamp" />
  </a>
  <nav class="nav" aria-label="Main">
    <ul>
      {links.map((l) => <li><a class="nav-link" href={l.href}>{l.label}</a></li>)}
    </ul>
    <a class="btn" href={`tel:${site.phoneHref}`}>Call {site.phone}</a>
  </nav>
  <button class="btn btn--light menu-btn" type="button" aria-expanded="false" aria-controls="sheet">Menu</button>
</header>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="sheet-top">
    <Roundel size={48} />
    <button class="btn btn--light close" type="button"><Icon name="x" weight="bold" size={18} />Close</button>
  </div>
  <ul>
    {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>)}
  </ul>
  <a class="btn sheet-call" href={`tel:${site.phoneHref}`}>Call {site.phone}</a>
</div>

<style>
  .header { display: flex; align-items: center; justify-content: space-between; height: 84px; position: relative; z-index: 5; }
  .mark { display: block; border-radius: 50%; }
  .nav { display: flex; align-items: center; gap: 36px; }
  .nav ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .nav-link { color: var(--ink); text-decoration: none; font-size: 17px; font-weight: 700; padding: 10px 0; text-underline-offset: .3em; text-decoration-thickness: 2px; text-decoration-color: var(--orange); }
  .nav-link:hover, .nav-link[aria-current] { text-decoration-line: underline; }
  .menu-btn { display: none; }
  .btn--light { background: var(--wash); color: var(--ink); }
  .btn--light:hover { background: #E6DACA; }

  .sheet { position: fixed; inset: 0; z-index: 50; background: var(--cream); padding: 20px; display: flex; flex-direction: column; gap: 32px; }
  .sheet[hidden] { display: none; }
  .sheet-top { display: flex; justify-content: space-between; align-items: center; }
  .sheet ul { list-style: none; margin: 0 0 auto; padding: 0; display: grid; gap: 4px; }
  .sheet li a { display: block; padding: 10px 0; font-size: 34px; font-weight: 700; letter-spacing: -.03em; color: var(--ink); text-decoration: none; }
  .sheet-call { width: 100%; min-height: 56px; }
  :global(.motion) .sheet:not([hidden]) li { animation: sheet-in .4s var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 900px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
    .header { height: 76px; }
    .mark :global(svg) { width: 48px; height: 48px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
  const sheet = document.getElementById("sheet")!;
  const close = sheet.querySelector<HTMLButtonElement>(".close")!;
  const focusables = () => [...sheet.querySelectorAll<HTMLElement>("a, button")];

  function open() {
    sheet.hidden = false;
    btn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    close.focus();
  }
  function shut(restore = true) {
    sheet.hidden = true;
    btn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    if (restore) btn.focus();
  }
  btn.addEventListener("click", open);
  close.addEventListener("click", () => shut());
  sheet.addEventListener("click", (e) => { if ((e.target as Element).closest("li a")) shut(false); });
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return shut();
    if (e.key !== "Tab") return;
    const f = focusables(), first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // Active state: the nav link for the section in view
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>(".header .nav-link[href^='#']")];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      navLinks.forEach((a) => a.getAttribute("href") === "#" + e.target.id ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
    }
  }, { rootMargin: "-45% 0px -50% 0px" });
  navLinks.forEach((a) => { const t = document.querySelector(a.getAttribute("href")!); if (t) io.observe(t); });
</script>
