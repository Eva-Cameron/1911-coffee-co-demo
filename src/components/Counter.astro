---
/* Two Hairline figures: interactive isometric line drawings of things on the counter. */
const figures = [
  { name: "cups", title: "Coffee", text: "Our own roast, poured into our own cups. Move across the row to lift a cup.", label: "A row of coffee cups on saucers. The cup under the pointer lifts off its saucer." },
  { name: "dome", title: "Bakes", text: "Baked every morning and kept under glass. Raise the dome to see what's on today.", label: "A cake stand under a glass dome. Moving the pointer up raises the dome off the cake." },
];
---
<section id="counter" class="counter section field-mustard" aria-labelledby="counter-title">
  <div class="wrap">
    <div class="chapter">
      <p class="part">Chapter four</p>
      <h2 id="counter-title" data-type data-type-speed="55">On the counter</h2>
      <p>Eggs, bacon, bread and milk from suppliers up and down the Northumberland coast. <span class="todo">(Supplier names to confirm.)</span></p>
    </div>
    <div class="figs">
      {figures.map((f, i) => (
        <figure class="fig" data-reveal style={`--i:${i}`}>
          <div class="plate">
            <span class="read" data-read-for={f.name} aria-hidden="true">rest</span>
            <div class="stage" data-figure={f.name} data-label={f.label}></div>
          </div>
          <figcaption>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .figs { display: grid; grid-template-columns: repeat(2, minmax(0, 520px)); justify-content: center; gap: 56px; }
  .fig { margin: 0; display: grid; gap: 18px; }
  .plate { position: relative; background: var(--sky); display: grid; place-items: center; padding: 14px; box-shadow: inset 0 0 0 14px var(--orange), inset 3px 3px 0 rgb(255 255 255 / .35), inset 17px 17px 0 rgb(0 0 0 / .18); }
  .read { position: absolute; top: 16px; right: 18px; z-index: 1; pointer-events: none; font-size: 14px; color: var(--muted); }
  .stage { width: 100%; aspect-ratio: 5 / 4; max-height: 440px; margin-inline: auto; }
  figcaption { display: grid; gap: 8px; justify-items: center; text-align: center; }
  figcaption p { font-size: 17px; color: var(--muted); max-width: 44ch; }
  .todo { color: var(--muted); }
  @media (max-width: 767px) { .figs { grid-template-columns: 1fr; gap: 40px; } .plate { box-shadow: inset 0 0 0 8px var(--orange); } }
</style>
<script>
  import "../scripts/figures.ts";
</script>
