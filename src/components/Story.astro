---
import { Picture } from "astro:assets";
import story from "../assets/photos/story.jpg";
---
<section id="story" class="story section field-sky" aria-labelledby="story-title">
  <div class="wrap">
    <div class="chapter">
      <p class="part">Chapter one</p>
      <h2 id="story-title" data-type data-type-speed="55">The shop on Queen Street</h2>
    </div>
    <div class="grid">
      <figure class="mat photo" data-reveal>
        <Picture src={story} alt="The 1911 Coffee Co. window logo at dusk, under the café's hanging lights" widths={[600, 832]} sizes="(max-width: 767px) 100vw, 440px" formats={["avif", "webp"]} loading="lazy" />
      </figure>
      <div class="letter">
        <!-- DRAFT COPY: replace with Joseph's own words once the story call is done. -->
        <p data-reveal style="--i:1">Since 2019 we've been pouring coffee and cooking breakfast behind the orange front at 28–30 Queen Street.</p>
        <p data-reveal style="--i:2">Everything on the counter is baked that morning. The bacon and sausage come from a local butcher, and the coffee in your cup is the same coffee in the bags on the shelf.</p>
        <p data-reveal style="--i:3">Pull up a chair and stay as long as you like.</p>
        <p class="sign" data-reveal style="--i:4">Joseph<span>1911 Coffee Co.</span></p>
      </div>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 440px)); justify-content: center; gap: 72px; align-items: center; }
  .photo { aspect-ratio: 4 / 5; overflow: hidden; }
  .photo :global(picture) { display: block; height: 100%; }
  .letter { display: grid; gap: 20px; }
  .letter p { font-size: 18px; line-height: 1.65; }
  .sign { display: grid; gap: 6px; margin-top: 12px; font-size: 17px !important; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  .sign span { font-size: 14px; font-weight: 400; letter-spacing: .08em; text-transform: none; color: var(--muted); }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 40px; max-width: 520px; margin-inline: auto; }
    .letter { text-align: center; }
    .letter p { font-size: 17px; }
    .photo { padding: 8px; }
  }
</style>
