---
import { Picture } from "astro:assets";
import story from "../assets/photos/story.jpg";
---
<section id="story" class="story section" aria-labelledby="story-title">
  <div class="wrap grid">
    <figure class="photo" data-reveal>
      <Picture src={story} alt="The 1911 Coffee Co. window logo at dusk, under the café's hanging lights" widths={[600, 832]} sizes="(max-width: 767px) 100vw, 520px" formats={["avif", "webp"]} loading="lazy" />
    </figure>
    <div class="letter">
      <h2 id="story-title" data-type data-type-speed="45">Our story</h2>
      <!-- DRAFT COPY: replace with Joseph's own words once the story call is done. -->
      <p data-reveal style="--i:1">Since 2019 we've been pouring coffee and cooking breakfast behind the orange front at 28–30 Queen Street.</p>
      <p data-reveal style="--i:2">Everything on the counter is baked that morning. The bacon and sausage come from a local butcher, and the coffee in your cup is the same coffee in the bags on the shelf.</p>
      <p data-reveal style="--i:3">Pull up a chair and stay as long as you like.</p>
      <p class="sign" data-reveal style="--i:4">Joseph<span>1911 Coffee Co.</span></p>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 80px; align-items: center; }
  .photo { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: var(--wash); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .letter { display: grid; gap: 22px; max-width: 34em; }
  .letter h2 { margin-bottom: 12px; }
  .letter p { font-size: 17px; line-height: 1.6; }
  .sign { display: grid; gap: 4px; font-size: 22px !important; font-weight: 700; margin-top: 8px; }
  .sign span { font-size: 14px; font-weight: 400; color: var(--muted); }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .letter p { font-size: 17px; }
  }
</style>
