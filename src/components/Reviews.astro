---
import reviews from "../content/reviews.json";
---
<section id="reviews" class="reviews section field-orange" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="chapter">
      <p class="part">Chapter five</p>
      <h2 id="reviews-title" data-type data-type-speed="55">What people say</h2>
      <p>Read what visitors have written, in their own words.</p>
    </div>
    <ul class="scores">
      {reviews.badges.map((b, i) => (
        <li data-reveal style={`--i:${i + 1}`}>
          <a href={b.href} rel="noopener">
            <span class="num">{b.score}</span>
            <span class="lbl">out of five on {b.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .scores { list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; gap: clamp(48px, 10vw, 160px); flex-wrap: wrap; }
  .scores a { display: grid; justify-items: center; gap: 14px; color: var(--ink); text-decoration: none; }
  .num { font-family: var(--font-title); font-size: clamp(60px, 2rem + 5vw, 108px); font-weight: 600; line-height: .9; letter-spacing: .02em; transition: transform .3s var(--ease-out); }
  .lbl { font-size: 14px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; text-decoration: underline; text-underline-offset: .5em; text-decoration-thickness: 2px; }
  .scores a:hover .num { transform: translateY(-4px); }
</style>
