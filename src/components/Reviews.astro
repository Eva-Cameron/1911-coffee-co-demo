---
import reviews from "../content/reviews.json";
---
<section class="reviews section" aria-labelledby="reviews-title">
  <div class="wrap">
    <header class="section-head">
      <p class="kicker" data-type>No. 04 — Kind words</p>
      <h2 id="reviews-title" class="ink">What people say</h2>
      <ul class="badges">
        {reviews.badges.map((b) => <li><a class="type" href={b.href} rel="noopener">{b.score}★ · {b.label}</a></li>)}
      </ul>
    </header>
    <div class="quotes">
      {reviews.quotes.map((q, i) => (
        <figure class="quote" data-reveal style={`--i:${i}`}>
          <p class="stars" role="img" aria-label={`${q.stars} out of 5 stars`}>{"★".repeat(q.stars)}</p>
          <blockquote><p>{q.text}</p></blockquote>
          <figcaption class="type">— {q.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .badges { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: center; }
  .badges a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1.5px var(--charcoal);
    color: var(--charcoal); text-decoration: none; font-size: 15px;
  }
  .badges a:hover { background: var(--cup); }
  .quotes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .quote { margin: 0; background: var(--cup); border-radius: 16px; padding: 28px; display: grid; gap: var(--space-3); align-content: start; }
  .quote:nth-child(1) { rotate: -1deg; }
  .quote:nth-child(3) { rotate: 1deg; }
  .stars { color: var(--ember); letter-spacing: .15em; }
  blockquote { margin: 0; font: 400 20px/1.35 var(--font-display); }
  figcaption { font-size: 15px; }
  @media (max-width: 767px) { .quotes { grid-template-columns: 1fr; } .quote { rotate: 0deg !important; } }
</style>
