---
/**
 * A small illustrated cup and saucer with a wisp of steam. It gently rocks when its parent
 * is hovered or focused, then settles. Decorative.
 */
interface Props { size?: number; class?: string; }
const { size = 64, class: cls } = Astro.props;
---
<svg class:list={["cup", cls]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g class="cup-body" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 30h30v4a15 15 0 0 1-30 0z" fill="var(--cup-fill, var(--paper))" />
    <path d="M44 33h4a5 5 0 0 1 0 10h-6" />
    <path d="M8 52c6 4 36 4 42 0" />
    <ellipse cx="29" cy="52" rx="21" ry="3.6" />
  </g>
  <g class="cup-steam" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <path d="M23 24c-3-4 3-6 0-11" /><path d="M30 24c-3-4 3-6 0-11" /><path d="M37 24c-3-4 3-6 0-11" />
  </g>
</svg>
<style>
  .cup { color: var(--espresso); overflow: visible; }
  .cup-body { transform-origin: 29px 52px; }
  .cup-steam { opacity: .7; transform-origin: 30px 24px; }
  :global(.motion) .cup-steam { animation: steam 3.6s ease-in-out infinite; }
  :global(:hover) > .cup .cup-body, :global(:focus-visible) > .cup .cup-body,
  :global(.rock:hover) .cup .cup-body { animation: rock 1.4s var(--ease-settle); }
  @keyframes rock { 20% { transform: rotate(-7deg); } 45% { transform: rotate(5deg); } 70% { transform: rotate(-2deg); } }
  @keyframes steam { 50% { transform: translateY(-2px); opacity: .35; } }
</style>
