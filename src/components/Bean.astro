---
/** A coffee bean: an oval split by an S-shaped seam. Decorative. */
interface Props { size?: number; class?: string; }
const { size = 12, class: cls } = Astro.props;
---
<svg class:list={["bean", cls]} width={size} height={size * 1.3} viewBox="0 0 20 26" aria-hidden="true" focusable="false">
  <ellipse cx="10" cy="13" rx="8.6" ry="11.6" fill="currentColor" />
  <path d="M10.4 2.4c-3.6 4.2-.6 7.4-1.4 10.8-.8 3.6-3.4 6.4-.2 10.6" fill="none" stroke="var(--bean-seam, var(--cream))" stroke-width="1.6" stroke-linecap="round" />
</svg>
