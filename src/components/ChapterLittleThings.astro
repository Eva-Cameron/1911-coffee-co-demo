---
/* Two photographs and two Hairline figures you can play with, in a simple row of squares. */
import { Picture } from "astro:assets";
import ChapterHead from "./ChapterHead.astro";
import cakes from "../assets/photos/cakes.jpg";
import soup from "../assets/photos/soup.jpg";
const tiles = [
  { kind: "photo", src: cakes, alt: "A raspberry and coconut sponge on the counter, the espresso machine behind it" },
  { kind: "figure", name: "cups", label: "A drawing of a row of coffee cups on saucers. The cup under the pointer lifts off its saucer." },
  { kind: "photo", src: soup, alt: "A bowl of golden soup with a bread roll and a pot of butter on a dark plate" },
  { kind: "figure", name: "dome", label: "A drawing of a cake stand under a glass dome. Moving the pointer up raises the dome off the cake." },
] as const;
---
<section id="little-things" class="chapter field-cream" aria-labelledby="little-title">
  <div class="wrap">
    <ChapterHead label="Cakes and soup" id="little-title"
      title="Please take your time." lede="A biscuit on the saucer. Cake under the counter lights. Soup that is always gluten free." />
    <ul class="tiles">
      {tiles.map((t, i) => (
        <li class="tile" data-reveal style={`--i:${i}`}>
          {t.kind === "photo"
            ? <Picture src={t.src} alt={t.alt} widths={[400, 700]} sizes="(max-width: 767px) 50vw, 260px" formats={["avif", "webp"]} loading="lazy" />
            : <div class="stage" data-figure={t.name} data-label={t.label}><span class="read" data-read-for={t.name} aria-hidden="true"></span></div>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 2vw, 24px); }
  .tile { aspect-ratio: 1; overflow: hidden; background: var(--stone); position: relative; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease-out); }
  .tile:hover :global(img) { transform: scale(1.04); }
  .stage { width: 100%; height: 100%; }
  .read { position: absolute; top: 10px; right: 12px; z-index: 1; font: 500 12px/1 var(--font-mono); color: var(--espresso); pointer-events: none; }
  @media (max-width: 767px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script>
  import "../scripts/figures.ts";
</script>
