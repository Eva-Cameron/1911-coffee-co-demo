---
import hours from "../content/hours.json";
/* A small chalk slate. It reads Open or Closed; hover, tap or focus flips it over, and the week's hours type out beneath it. */
const time = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return `${h % 12 || 12}${m ? ":" + String(m).padStart(2, "0") : ""}${h < 12 ? "am" : "pm"}`;
};
type Day = { day: number; name: string; open?: string; close?: string; closed?: boolean };
const days = hours.days as Day[];
const slot = (d: Day) => (d.closed ? "closed" : `${d.open}-${d.close}`);
const groups: { names: string[]; day: Day }[] = [];
for (const d of days) {
  const last = groups.at(-1);
  if (last && slot(last.day) === slot(d)) last.names.push(d.name);
  else groups.push({ names: [d.name], day: d });
}
const short = (n: string) => n.slice(0, 3);
const span = (names: string[], shorten: boolean) => {
  const label = shorten ? names.map(short) : names;
  return names.length > 1 ? `${label[0]}${shorten ? "–" : " to "}${label.at(-1)}` : label[0];
};
const lines = groups.map((g) => `${span(g.names, true)}  ${g.day.closed ? "Closed" : `${time(g.day.open!)}–${time(g.day.close!)}`}`);
const spoken = groups.map((g) => `${span(g.names, false)}, ${g.day.closed ? "closed" : `${time(g.day.open!)} to ${time(g.day.close!)}`}`).join("; ");
---
<div class="door-sign" data-door-sign data-hours={JSON.stringify(hours)} data-lines={JSON.stringify(lines)}>
  <button class="sign" type="button" aria-expanded="false" aria-describedby="sign-hours">
    <span class="card">
      <span class="face front">
        <span class="state" data-state-word>Open</span>
        <span class="sub" data-state-sub>Mon–Sat, 8am–3pm</span>
      </span>
      <span class="face back" aria-hidden="true"><span class="state">Hours</span></span>
    </span>
    <span class="visually-hidden">Show opening hours</span>
  </button>
  <p class="typed" aria-hidden="true" data-typed></p>
  <p id="sign-hours" class="visually-hidden">Opening hours: {spoken}.</p>
</div>

<style>
  /* Fredericka the Great (OFL), cut down to the letters of Open, Closed and Hours. */
  @font-face { font-family: 'Fredericka the Great'; src: url('../assets/fonts/fredericka-sign.woff2') format('woff2'); font-display: swap; }
  .door-sign { display: grid; justify-items: center; gap: 18px; }
  .sign { padding: 0; border: 0; background: none; cursor: pointer; perspective: 700px; font: inherit; color: #F1EEE6; }
  .sign:focus-visible { outline: 3px solid var(--espresso); outline-offset: 6px; }
  .card { position: relative; display: block; width: 200px; height: 104px; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.3, 1.3, .5, 1); }
  .sign[aria-expanded="true"] .card { transform: rotateY(180deg); }
  .face {
    position: absolute; inset: 0;
    display: grid; justify-items: center; align-content: center; gap: 2px;
    background: #2E3430; border-radius: 4px;
    box-shadow: inset 2px 2px 0 rgb(255 255 255 / .1), inset -2px -2px 0 rgb(0 0 0 / .35);
    backface-visibility: hidden;
  }
  .back { transform: rotateY(180deg); }
  .state { font-family: 'Fredericka the Great', var(--font-sans); font-size: 38px; line-height: 1; }
  .sub { font-family: 'Schoolbell', var(--font-sans); font-size: 18px; color: #DCDCD2; }

  /* The hours, typed out under the sign; the space is held so nothing below jumps */
  .typed { min-height: calc(2 * 1.5em); margin: 0; font: 500 15px/1.5 var(--font-mono); letter-spacing: .06em; white-space: pre-line; text-align: center; color: var(--espresso); }
  .typed:not(:empty)::after { content: ""; display: inline-block; width: 2px; height: .95em; margin-left: 3px; vertical-align: -.12em; background: currentColor; animation: caret 1s steps(1) infinite; }
  .typed[data-done]::after { display: none; }
  @keyframes caret { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>

<script>
  type Day = { day: number; name: string; open?: string; close?: string; closed?: boolean };
  const root = document.querySelector<HTMLElement>("[data-door-sign]");
  if (root) {
    const sign = root.querySelector<HTMLButtonElement>(".sign")!;
    const typed = root.querySelector<HTMLElement>("[data-typed]")!;
    const full = (JSON.parse(root.dataset.lines!) as string[]).join("\n");
    const { timezone, days } = JSON.parse(root.dataset.hours!) as { timezone: string; days: Day[] };
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // The front: Open or Closed right now, in the shop's own time zone.
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat("en-GB", { timeZone: timezone, weekday: "short", hour: "2-digit", minute: "2-digit", hourCycle: "h23" })
        .formatToParts(new Date()).map((p) => [p.type, p.value]),
    );
    const iso = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].indexOf(parts.weekday) + 1;
    const now = `${parts.hour}:${parts.minute}`;
    const today = days.find((d) => d.day === iso);
    const fmt = (t: string) => {
      const [h, m] = t.split(":").map(Number);
      return `${h % 12 || 12}${m ? ":" + String(m).padStart(2, "0") : ""}${h < 12 ? "am" : "pm"}`;
    };
    const word = root.querySelector<HTMLElement>("[data-state-word]")!;
    const sub = root.querySelector<HTMLElement>("[data-state-sub]")!;
    if (today && !today.closed && now >= today.open! && now < today.close!) {
      word.textContent = "Open";
      sub.textContent = `until ${fmt(today.close!)}`;
    } else {
      const later = today && !today.closed && now < today.open!;
      let next = today!;
      if (!later) for (let step = 1; step <= 7; step++) {
        const candidate = days.find((d) => d.day === ((iso - 1 + step) % 7) + 1);
        if (candidate && !candidate.closed) { next = candidate; break; }
      }
      word.textContent = "Closed";
      sub.textContent = `opens ${fmt(next.open!)}${later ? "" : " " + next.name.slice(0, 3)}`;
    }

    // Flipped: the hours type out beneath the sign, one letter at a time.
    let timer = 0;
    const type = () => {
      clearTimeout(timer);
      typed.removeAttribute("data-done");
      if (still) { typed.textContent = full; typed.setAttribute("data-done", ""); return; }
      let count = 0;
      const step = () => {
        count++;
        typed.textContent = full.slice(0, count);
        if (count < full.length) timer = window.setTimeout(step, full[count - 1] === "\n" ? 200 : 32 + Math.random() * 28);
        else typed.setAttribute("data-done", "");
      };
      typed.textContent = "";
      timer = window.setTimeout(step, 380);
    };
    const show = () => { if (sign.getAttribute("aria-expanded") === "true") return; sign.setAttribute("aria-expanded", "true"); type(); };
    const hide = () => { clearTimeout(timer); sign.setAttribute("aria-expanded", "false"); typed.textContent = ""; };

    sign.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") show(); });
    root.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") hide(); });
    sign.addEventListener("focus", () => { if (sign.matches(":focus-visible")) show(); });
    sign.addEventListener("blur", hide);
    sign.addEventListener("click", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") return;
      sign.getAttribute("aria-expanded") === "true" ? hide() : show();
    });
  }
</script>
