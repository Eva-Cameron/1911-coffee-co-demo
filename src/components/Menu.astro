---
import menu from "../content/menu.json";
import Icon from "./Icon.astro";
const TAGS: Record<string, { label: string; cls: string }> = {
  V: { label: "Vegetarian", cls: "veg" },
  VG: { label: "Vegan", cls: "vegan" },
  GF: { label: "Gluten free", cls: "gf" },
};
const ICONS: Record<string, string> = { Brunch: "egg", Lunch: "fork-knife", Coffee: "coffee", Cakes: "cake" };
const price = (p: number) => `£${p.toFixed(2)}`;
---
<section id="menu" class="menu section" aria-labelledby="menu-title">
  <div class="wrap">
    <header class="section-head">
      <div class="title">
        <p class="kicker" data-type>No. 02 — The menu</p>
        <h2 id="menu-title" data-type data-type-speed="45">Made here, every morning</h2>
      </div>
      <p>Breakfast until 11:30, then lunch until we close. Ask at the counter about allergens.</p>
    </header>
    <ul class="legend" aria-label="Dietary key">
      {Object.entries(TAGS).map(([k, t]) => <li><span class={`tag ${t.cls}`}>{k}</span>{t.label}</li>)}
    </ul>
    <div class="cols">
      {menu.map((s) => (
        <section class="docket card" aria-labelledby={`m-${s.section}`}>
          <header class="docket-head">
            <span class="ico"><Icon name={ICONS[s.section] ?? "coffee"} size={20} /></span>
            <div>
              <h3 id={`m-${s.section}`}>{s.section}</h3>
              <p class="note">{s.note}</p>
            </div>
          </header>
          <dl>
            {s.items.map((it, i) => (
              <div class="menu-row" style={`--i:${i}`}>
                <dt>
                  <span class="name">{it.name}</span>
                  {it.tags.map((t) => <abbr class={`tag ${TAGS[t].cls}`} title={TAGS[t].label}>{t}</abbr>)}
                </dt>
                <dd class="price type">{price(it.price)}</dd>
                {it.desc && <dd class="desc">{it.desc}</dd>}
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</section>
<style>
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-4); list-style: none; margin: 0 0 var(--space-4); padding: 0; font-size: 14px; color: var(--muted); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .docket { padding: 0; overflow: hidden; }
  .docket-head {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--wash); border-bottom: 1px solid var(--line);
  }
  .ico { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 9px; background: var(--orange); color: var(--on-fill); flex: none; }
  .note { font-size: 13.5px; color: var(--muted); margin-top: 2px; }
  dl { margin: 0; padding: var(--space-2) var(--space-5) var(--space-4); }
  .menu-row { display: grid; grid-template-columns: 1fr auto; align-items: end; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .menu-row:last-child { border-bottom: 0; }
  dt { font-weight: 620; display: flex; align-items: center; gap: 6px; }
  .name { min-width: 0; }
  dt::after { content: ""; flex: 1 0 24px; border-bottom: 2px dotted var(--oak); margin: 0 8px 5px; align-self: flex-end; }
  .price { margin: 0; font-variant-numeric: tabular-nums; font-size: 15px; font-weight: 500; }
  .desc { grid-column: 1 / -1; margin: 3px 0 0; font-size: 14px; color: var(--muted); max-width: 52ch; }
  .tag { flex: none; height: 20px; padding: 0 6px; font-size: 11px; }
  .veg { background: var(--veg-tint); color: var(--veg); }
  .vegan { background: var(--vegan-tint); color: var(--vegan); }
  .gf { background: var(--gf-tint); color: var(--gf); }
  abbr.tag { cursor: help; }
  @media (max-width: 767px) {
    .cols { grid-template-columns: 1fr; gap: var(--space-3); }
    .docket-head, dl { padding-inline: var(--space-4); }
  }
</style>
