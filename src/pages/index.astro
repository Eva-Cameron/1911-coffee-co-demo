---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Tiles from "../components/Tiles.astro";
import Story from "../components/Story.astro";
import Menu from "../components/Menu.astro";
import Counter from "../components/Counter.astro";
import Reviews from "../components/Reviews.astro";
import FindUs from "../components/FindUs.astro";
import Footer from "../components/Footer.astro";
import site from "../content/site.json";
import hours from "../content/hours.json";

const DOW = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: site.name,
  url: Astro.site?.href,
  telephone: site.phone,
  image: new URL("/og.jpg", Astro.site).href,
  priceRange: "£",
  servesCuisine: ["Breakfast", "Brunch", "Coffee", "Cakes"],
  hasMenu: new URL("/#menu", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.street,
    addressLocality: site.town,
    postalCode: site.postcode,
    addressCountry: "GB",
  },
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: hours.days.map((d) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: `https://schema.org/${DOW[d.day - 1]}`,
    opens: d.open,
    closes: d.close,
  })),
  sameAs: site.socials.map((s) => s.href),
};
---
<Layout
  title="1911 Coffee Co. | Breakfast & Coffee in Amble"
  description="Breakfast, lunch, home bakes and our own-roast coffee at 28–30 Queen Street, Amble. Dog friendly. Open today — see the hours."
  jsonLd={jsonLd}
>
  <div class="frame">
    <Header />
    <main id="main">
      <Hero />
      <Tiles />
      <Story />
      <Menu />
      <Counter />
      <Reviews />
      <FindUs />
    </main>
  </div>
  <Footer />
</Layout>

<style>
  .frame {
    position: relative;
    z-index: 1;
    width: min(1280px, calc(100% - 80px));
    margin: 40px auto;
    outline: 6px solid var(--orange);
    outline-offset: 10px;
    box-shadow: 0 0 0 16px var(--deep), 0 24px 60px rgb(20 6 0 / .5);
    border-radius: var(--radius-card);
    background: var(--cream);
    overflow: hidden;
    isolation: isolate;
  }
  @media (max-width: 767px) {
    .frame { width: auto; margin: 26px 18px; border-radius: 10px; outline-width: 3px; outline-offset: 5px; box-shadow: 0 0 0 8px var(--deep); }
  }
</style>
