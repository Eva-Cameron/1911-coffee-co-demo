---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Place from "../components/chapters/Place.astro";
import Coffee from "../components/chapters/Coffee.astro";
import Breakfast from "../components/chapters/Breakfast.astro";
import Lunch from "../components/chapters/Lunch.astro";
import Little from "../components/chapters/Little.astro";
import Welcome from "../components/chapters/Welcome.astro";
import Visitors from "../components/chapters/Visitors.astro";
import MenuCard from "../components/chapters/MenuCard.astro";
import FindUs from "../components/chapters/FindUs.astro";
import Footer from "../components/Footer.astro";
import site from "../content/site.json";
import hours from "../content/hours.json";

const DOW = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
// Structured data carries only what we can state: opening hours go in once they are verified.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: site.name,
  url: Astro.site?.href,
  telephone: site.phone,
  image: new URL("/og.jpg", Astro.site).href,
  servesCuisine: ["Coffee", "Breakfast", "Lunch", "Cakes"],
  hasMenu: new URL("/#menu", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.street,
    addressLocality: site.town,
    addressRegion: "Northumberland",
    postalCode: site.postcode,
    addressCountry: "GB",
  },
  ...(hours.verified && {
    openingHoursSpecification: hours.days.map((d) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: `https://schema.org/${DOW[d.day - 1]}`,
      opens: d.open,
      closes: d.close,
    })),
  }),
  sameAs: site.socials.filter((s) => !s.href.includes("/Search")).map((s) => s.href),
};
---
<Layout
  title="1911 Coffee Co. | Café on Queen Street, Amble, Northumberland"
  description="A welcoming independent café at 28–30 Queen Street, Amble, Northumberland: carefully made coffee, proper breakfasts, a little lunch and cakes. Menu, directions and contact details."
  jsonLd={jsonLd}
>
  <Header />
  <main id="main">
    <Hero />
    <Place />
    <Coffee />
    <Breakfast />
    <Lunch />
    <Little />
    <Welcome />
    <Visitors />
    <MenuCard />
    <FindUs />
  </main>
  <Footer />
</Layout>
