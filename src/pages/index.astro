---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ChapterWelcome from "../components/ChapterWelcome.astro";
import ChapterCoffee from "../components/ChapterCoffee.astro";
import ChapterBreakfast from "../components/ChapterBreakfast.astro";
import ChapterLunch from "../components/ChapterLunch.astro";
import ChapterAmble from "../components/ChapterAmble.astro";
import ChapterWelcomeTable from "../components/ChapterWelcomeTable.astro";
import ChapterVisitors from "../components/ChapterVisitors.astro";
import Menu from "../components/Menu.astro";
import FindUs from "../components/FindUs.astro";
import Footer from "../components/Footer.astro";
import site from "../content/site.json";
import hours from "../content/hours.json";

type Day = { day: number; open?: string; close?: string; closed?: boolean };
const DOW = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: site.name,
  url: Astro.site?.href,
  telephone: site.phone,
  image: new URL("/og.jpg", Astro.site).href,
  priceRange: "£",
  servesCuisine: ["Breakfast", "Lunch", "Coffee", "Cakes"],
  hasMenu: new URL("/#menu", Astro.site).href,
  acceptsReservations: true,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.street,
    addressLocality: site.town,
    postalCode: site.postcode,
    addressCountry: "GB",
  },
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: (hours.days as Day[]).filter((d) => !d.closed).map((d) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: `https://schema.org/${DOW[d.day - 1]}`,
    opens: d.open,
    closes: d.close,
  })),
  sameAs: site.socials.map((s) => s.href),
};
---
<Layout
  title="1911 Coffee Co. | Coffee, Breakfast & Lunch in Amble"
  description="Coffee, proper breakfasts, fresh lunches and home bakes at 28–30 Queen Street, Amble. Open Monday to Saturday, 8am to 3pm."
  jsonLd={jsonLd}
>
  <div class="field-orange"><Header /></div>
  <main id="main">
    <div class="field-orange"><Hero /></div>
    <ChapterCoffee />
    <ChapterBreakfast />
    <ChapterLunch />
    <ChapterAmble />
    <Menu />
    <ChapterWelcome />
    <ChapterWelcomeTable />
    <ChapterVisitors />
    <FindUs />
  </main>
  <Footer />
</Layout>

<style>
  main { overflow-x: clip; }
</style>
